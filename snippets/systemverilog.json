{
  "RTL module": {
    "prefix": "rtlmod",
    "body": [
      "module ${1:module_name} #(",
      "    parameter int ${2:WIDTH} = ${3:8}",
      ") (",
      "    input  logic clk,",
      "    input  logic rst_n,",
      "    ${4:// ports}",
      ");",
      "",
      "    $0",
      "",
      "endmodule : ${1:module_name}"
    ],
    "description": "Parameterized SystemVerilog module"
  },
  "Sequential logic": {
    "prefix": "ff",
    "body": [
      "always_ff @(posedge ${1:clk} or negedge ${2:rst_n}) begin",
      "    if (!${2:rst_n}) begin",
      "        ${3:q} <= ${4:'0};",
      "    end else begin",
      "        ${3:q} <= ${5:d};",
      "    end",
      "end",
      "$0"
    ],
    "description": "Flip-flop with active-low asynchronous reset"
  },
  "Combinational logic": {
    "prefix": "comb",
    "body": [
      "always_comb begin",
      "    ${1:// assign defaults}",
      "    $0",
      "end"
    ],
    "description": "Combinational block with explicit defaults"
  }
}
